generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Settings {
  id              Int     @id @default(autoincrement())
  shop            String  @unique
  whatsappEnabled Boolean @default(false)
  codEnabled      Boolean @default(false)
}

model CodOrder {
  id             String   @id @default(cuid())
  shop           String
  orderId        String
  orderNumber    String
  customerName   String
  phone          String
  products       String
  address        String
  status         String   @default("pending")
  method         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reminderAt     DateTime
  lockUntil      DateTime?
  calls          CodCall[]
  messages       CodMessage[]
  events         CodEvent[]
  @@unique([shop, orderId])
  @@index([shop, createdAt])
  @@index([status, reminderAt])
}

model CodCall {
  id        String   @id @default(cuid())
  codId     String
  order     CodOrder @relation(fields: [codId], references: [id], onDelete: Cascade)
  attempt   Int
  outcome   String
  actor     String
  createdAt DateTime @default(now())
  @@unique([codId, attempt])
}

model CodMessage {
  id         String   @id @default(cuid())
  codId      String
  order      CodOrder @relation(fields: [codId], references: [id], onDelete: Cascade)
  kind       String
  state      String   @default("queued")
  messageId  String?  @unique
  error      String?
  createdAt  DateTime @default(now())
  @@unique([codId, kind])
}

model CodEvent {
  id        String   @id @default(cuid())
  codId     String
  order     CodOrder @relation(fields: [codId], references: [id], onDelete: Cascade)
  detail    String
  createdAt DateTime @default(now())
}

model AbandonedCheckout {
  id            Int       @id @default(autoincrement())
  shop          String
  checkoutToken String    @unique
  phone         String
  customerName  String
  orderDetails  String
  imageUrl      String?
  checkoutUrl   String
  createdAt     DateTime  @default(now())
  converted     Boolean   @default(false)
  messaged      Boolean   @default(false)
}
