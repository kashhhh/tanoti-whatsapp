generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Settings {
  id              Int     @id @default(autoincrement())
  shop            String  @unique
  whatsappEnabled Boolean @default(false)
}

model AbandonedCheckout {
  id            Int       @id @default(autoincrement())
  shop          String
  checkoutToken String    @unique
  phone         String
  customerName  String
  orderDetails  String
  imageUrl      String?
  checkoutUrl   String
  createdAt     DateTime  @default(now())
  converted     Boolean   @default(false)
  messaged      Boolean   @default(false)
}